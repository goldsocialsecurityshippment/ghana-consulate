# Smart Finance AI - Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# =============================================
# SUPABASE CONFIGURATION
# Get these from: https://supabase.com/dashboard/project/_/settings/api
# =============================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# =============================================
# APP CONFIGURATION
# =============================================
EXPO_PUBLIC_APP_NAME=Smart Finance AI
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_DEFAULT_CURRENCY=GHS

# =============================================
# ANTHROPIC AI (for AI Insights - optional)
# =============================================
# EXPO_PUBLIC_ANTHROPIC_API_KEY=your-anthropic-key

# =============================================
# EAS / EXPO (for push notifications)
# =============================================
EXPO_PUBLIC_EAS_PROJECT_ID=your-eas-project-id
